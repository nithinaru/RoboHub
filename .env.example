# Supabase project (Database, Storage, Realtime, pgvector)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket for clips, datasets, and SmolVLA checkpoints
SUPABASE_STORAGE_BUCKET=robohub-artifacts

# Video lead (Gemini still + Veo) and GPU rental
GEMINI_API_KEY=
RUNPOD_API_KEY=

# How many accepted demonstrations a task needs before SmolVLA training starts
ROBOHUB_MIN_ACCEPTED=4
ROBOHUB_TRAIN_STEPS=3000
ROBOHUB_ARM=so101
